# Entorno de ejecución. En producción usar "production".
# NODE_ENV=production

# Puerto del servidor (en producción el hosting suele asignarlo).
PORT=8787

# Interfaz de escucha. Usar 0.0.0.0 en un hosting.
HOST=0.0.0.0

# En producción la base debe ser PostgreSQL.
# Ejemplo con Neon:
# DATABASE_URL=postgresql://usuario:clave@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
#
# DATABASE_SSL admite: true/require (por defecto para hosts remotos),
# false/disable (solo para PostgreSQL local o certificados no verificables).

# Para desarrollo local, si no se define DATABASE_URL, se usa PGlite
# (PostgreSQL embebido) con persistencia en esta carpeta.
# PGLITE_DATA_DIR=.data/pglite

# Cookie de sesión administrativa: secure=true detrás de HTTPS.
# En desarrollo local por HTTP debe quedar en false (valor por defecto sin NODE_ENV=production).
# COOKIE_SECURE=false

# Respetar X-Forwarded-Proto / X-Forwarded-For detrás de un proxy (Render, etc.).
# En producción se activa por defecto.
# TRUST_PROXY=true

# Permitir el seed de demostración incluso con DATABASE_URL definida.
# No usar en producción.
# ALLOW_DEMO_SEED=0
